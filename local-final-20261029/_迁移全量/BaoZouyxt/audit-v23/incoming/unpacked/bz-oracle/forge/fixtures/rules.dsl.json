{
  "_说明": "演示规则 DSL。真实规则按 442 表的列写；source 必填。",
  "User.buyShopItem": {
    "params": {
      "itemID": "int",
      "num": "int>0"
    },
    "guards": [
      {
        "expr": "T.item[p.itemID] && T.item[p.itemID].BuyPrice > 0",
        "eRet": 0
      }
    ],
    "cost": [
      {
        "wallet": "coins",
        "amount": "T.item[p.itemID].BuyPrice * p.num"
      }
    ],
    "gain": [
      {
        "item": "p.itemID",
        "num": "p.num"
      }
    ],
    "source": "item 表 BuyPrice 列（NormalShopUI 货架价，scripts2.js:46443）"
  },
  "User.saleItem": {
    "params": {
      "itemID": "int",
      "num": "int>0"
    },
    "guards": [
      {
        "expr": "p.uid === undefined || !Object.values(s.equipments || {}).map(String).includes(String(p.uid))",
        "pre": true,
        "reject": "errorCode",
        "errorCode": 1,
        "source": "R22 §三.2 真服实测：已穿戴装备不可卖"
      },
      {
        "expr": "T.item[p.itemID]",
        "eRet": 0
      }
    ],
    "cost": [
      {
        "item": "p.itemID",
        "num": "p.num"
      }
    ],
    "gain": [
      {
        "wallet": "coins",
        "amount": "T.item[p.itemID].Price * p.num"
      }
    ],
    "source": "item 表 Price 列（演示）"
  }
}